{
  "name": "dsh-plugin-adaptive-router",
  "version": "0.1.0",
  "description": "Lightweight native DSH model and reasoning effort routing",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').copyFileSync('src/client.js','lib/client.js')\"",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xuanyi-king/DSH-Adaptive-Router.git"
  },
  "homepage": "https://github.com/Xuanyi-king/DSH-Adaptive-Router#readme",
  "bugs": {
    "url": "https://github.com/Xuanyi-king/DSH-Adaptive-Router/issues"
  }
}
